{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akko Studio",
  "version": "0.12.0",
  "identifier": "fr.local.akkostudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Akko Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://tauri.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: tauri: asset: https://tauri.localhost; font-src 'self' tauri: asset: https://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost tauri: asset: https://tauri.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kayzidev",
    "homepage": "https://github.com/kayzidev/open-akko",
    "copyright": "Copyright (C) 2026 dniminenn",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Configuration des claviers AKKO",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-sharkfin.rules": "../../packaging/70-sharkfin.rules",
          "/usr/share/doc/sharkfin/copyright": "../../LICENSE",
          "/usr/share/doc/sharkfin/THIRD-PARTY-NOTICES.md": "../../THIRD-PARTY-NOTICES.md",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-sharkfin.rules": "../../packaging/70-sharkfin.rules",
          "/usr/share/doc/sharkfin/copyright": "../../LICENSE",
          "/usr/share/doc/sharkfin/THIRD-PARTY-NOTICES.md": "../../THIRD-PARTY-NOTICES.md",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEM0UwOEZCREQzRTM3MzkKUldRNU56N2Qrd2crYldNVys5Tmd5TEJJRHhQTnNtcXR1a0VhMFgva1ZQRmJocDhTQjRPSTc5MVIK",
      "endpoints": [
        "https://github.com/kayzidev/open-akko/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
